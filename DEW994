-- 2. ฟังก์ชันมองทะลุสีรุ้ง (Rainbow ESP)
----------------------------------------------------
task.spawn(function()
	while task.wait(0.1) do
		if ESPEnabled then
			local hue = (tick() % 5) / 5
			local rainbowColor = Color3.fromHSV(hue, 1, 1)

			for _, player in pairs(Players:GetPlayers()) do
				if player ~= LocalPlayer and player.Character then
					local highlight = player.Character:FindFirstChild("DEW994_ESP")
					if not highlight then
						highlight = Instance.new("Highlight")
						highlight.Name = "DEW994_ESP"
						highlight.FillTransparency = 0.5
						highlight.OutlineTransparency = 0
						highlight.Parent = player.Character
					end
					highlight.FillColor = rainbowColor
					highlight.OutlineColor = rainbowColor
				end
			end
		else
			for _, player in pairs(Players:GetPlayers()) do
				if player.Character and player.Character:FindFirstChild("DEW994_ESP") then
					player.Character.DEW994_ESP:Destroy()
				end
			end
		end
	end
end)

----------------------------------------------------
-- 3. ฟังก์ชันกดวาร์ป (Click Teleport สำหรับมือถือ)
----------------------------------------------------
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed or not ClickTPEnabled then return end

	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		local unitRay = Camera:ScreenPointToRay(input.Position.X, input.Position.Y)
		local raycastResult = workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000)
		
		if raycastResult and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
			LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(raycastResult.Position + Vector3.new(0, 3, 0))
		end
	end
end)

